{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "arrangrr/style-kb/style-kb.schema.json",
  "title": "Style KB entry",
  "description": "One arranger-style file abstracted for a dynamic MIDI generator. Produced by app/tools/arrstyle-extractor. Every source file yields exactly one entry with a parse_status.",
  "type": "object",
  "required": ["style_id", "source_file", "format", "parse_status", "confidence"],
  "properties": {
    "style_id": {"type": "string"},
    "source_file": {"type": "string", "description": "Path relative to the corpus root (traceability)."},
    "sha1": {"type": "string"},
    "bytes": {"type": "integer"},
    "format": {"type": "string", "enum": ["sff", "smf", "korg", "unknown"]},
    "has_casm": {"type": "boolean"},
    "sff_version": {"type": ["string", "null"], "enum": ["SFF1", "SFF2", null]},
    "parse_status": {"type": "string", "enum": ["ok", "partial", "failed"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "musical_profile": {
      "type": "object",
      "properties": {
        "genre": {"type": ["string", "null"]},
        "subgenre": {"type": ["string", "null"]},
        "feel": {"type": ["string", "null"], "enum": ["straight", "swing", "latin", "funk", "four_on_floor", "ballad", null]},
        "tempo_bpm": {"type": ["integer", "null"]},
        "tempo_range": {"type": "array", "items": {"type": "integer"}},
        "time_signature": {"type": "string"},
        "ppqn": {"type": "integer"},
        "key_signature": {"type": ["string", "null"]},
        "swing": {"type": "number", "description": "~0.5 straight, ->0.66 triplet swing (best-effort)."},
        "energy": {"type": "number"},
        "density": {"type": "number"},
        "complexity": {"type": "number"},
        "roles_present": {"type": "array", "items": {"type": "string"}},
        "section_count": {"type": "integer"},
        "energy_curve_main": {"type": "object", "description": "Main A..D -> density (the arranger energy ladder)."}
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {"type": "string"},
          "type": {"type": "string", "enum": ["intro", "main", "fill", "break", "ending", "unknown"]},
          "bars": {"type": "number"},
          "note_count": {"type": "integer"},
          "density": {"type": "number"},
          "tracks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "channel": {"type": "integer"},
                "role": {"type": "string"},
                "program": {"type": ["integer", "null"]},
                "note_count": {"type": "integer"},
                "note_density_per_bar": {"type": "number"},
                "velocity_mean": {"type": "integer"},
                "velocity_profile": {"type": "array", "items": {"type": "integer"}},
                "pitch_low": {"type": ["integer", "null"]},
                "pitch_high": {"type": ["integer", "null"]},
                "rhythm_cell_16": {"type": "array", "items": {"type": "integer"}},
                "syncopation": {"type": "number"},
                "drum_map": {"type": "object"}
              }
            }
          }
        }
      }
    },
    "patterns": {"type": "array", "items": {"$ref": "pattern.schema.json"}},
    "arranger_notes": {"type": "array", "items": {"type": "string"}},
    "programming_notes": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
