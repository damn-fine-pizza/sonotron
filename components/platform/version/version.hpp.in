#pragma once

// Auto-generated by components/platform/version/CMakeLists.txt at CMake
// configure time -- do not edit this file by hand, it is never tracked in
// git (build-dir only). To bump the release version edit the repo-root
// VERSION file (MAJOR.MINOR) via scripts/bump-version.sh; the BUILD number
// and git SHA below regenerate on the next CMake configure.
//
// HOST-ONLY: components/platform/version is added only on the non-firmware
// (host/apps) branch of the top-level CMakeLists.txt and must never be
// pulled into the freestanding core/arm-none-eabi build.

namespace sonotron::version {

// MAJOR.MINOR, the repo-root VERSION file's single source of truth.
inline constexpr const char* kVersionMajorMinor = "@SONOTRON_VERSION_MAJOR_MINOR@";

// BUILD: total commit count reachable from HEAD (`git rev-list --count
// HEAD`) -- deterministic, monotonic, identical locally and in CI. 0 when
// git is unavailable (a source tarball with no .git directory/worktree).
inline constexpr int kBuildNumber = @SONOTRON_BUILD_NUMBER@;
inline constexpr const char* kBuildNumberString = "@SONOTRON_BUILD_NUMBER@";

// Short commit SHA at configure time ("unknown" when git is unavailable).
inline constexpr const char* kGitSha = "@SONOTRON_GIT_SHA@";

// "MAJOR.MINOR.BUILD", e.g. "0.3.418".
inline constexpr const char* kVersionString = "@SONOTRON_VERSION_STRING@";

// "MAJOR.MINOR.BUILD+sha", e.g. "0.3.418+abc1234".
inline constexpr const char* kVersionFull = "@SONOTRON_VERSION_FULL@";

}  // namespace sonotron::version
