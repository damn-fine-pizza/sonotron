{
  "version": 6,
  "configurePresets": [
    {
      "name": "host",
      "displayName": "Host (debug, tests)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache"
      }
    },
    {
      "name": "host-release",
      "displayName": "Host (release)",
      "inherits": "host",
      "binaryDir": "${sourceDir}/build/host-release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "coverage",
      "displayName": "Host (unit-test coverage, gcov instrumented)",
      "inherits": "host",
      "binaryDir": "${sourceDir}/build/coverage",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "--coverage",
        "CMAKE_EXE_LINKER_FLAGS": "--coverage",
        "CMAKE_CXX_COMPILER_LAUNCHER": ""
      }
    },
    {
      "name": "sanitize",
      "displayName": "Host (ASan+UBSan, sanitizer-instrumented)",
      "inherits": "host",
      "binaryDir": "${sourceDir}/build/sanitize",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer -g -O1",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer -g -O1",
        "CMAKE_CXX_COMPILER_LAUNCHER": ""
      }
    },
    {
      "name": "tidy",
      "displayName": "Clang compile database for clang-tidy",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/tidy",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_COMPILER_LAUNCHER": ""
      }
    },
    {
      "name": "arm",
      "displayName": "STM32 anchor (Cortex-M7 cross, dev: ARR_ASSERT traps)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/arm",
      "toolchainFile": "${sourceDir}/cmake/toolchains/arm-cortex-m7.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache"
      }
    },
    {
      "name": "arm-release",
      "displayName": "STM32 firmware release (ARR_ASSERT compiled out, D-STM32 graceful degradation)",
      "inherits": "arm",
      "binaryDir": "${sourceDir}/build/arm-release",
      "cacheVariables": {
        "ARRANGRR_FIRMWARE_RELEASE": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "host", "configurePreset": "host" },
    { "name": "host-release", "configurePreset": "host-release" },
    { "name": "coverage", "configurePreset": "coverage" },
    { "name": "sanitize", "configurePreset": "sanitize" },
    { "name": "arm", "configurePreset": "arm" },
    { "name": "arm-release", "configurePreset": "arm-release" }
  ],
  "testPresets": [
    {
      "name": "host",
      "configurePreset": "host",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "sanitize",
      "configurePreset": "sanitize",
      "output": { "outputOnFailure": true }
    }
  ]
}
